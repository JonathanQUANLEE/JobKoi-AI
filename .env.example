# 复制本文件为 .env 后按需填写。0.2 版本不需要任何 AI API key。
#
# 推荐普通用户通过 GUI 修改配置：
#   uv run python -m boss_zhipin.tauri
#
# 高级用户也可以使用 profile：
#   uv run main.py --profile backend-intern
#   uv run main.py --profile ai-intern

# ─── 基础信息 ───────────────────────────────────────────────────────────────

# 你的名字，用于运行前校验和日志记录。
BOSS_USR_NAME=

# 岗位搜索词。留空时使用 BOSS 默认推荐 feed。
BOSS_LABEL=后端开发实习

# BOSS 起始页 URL。你可以在浏览器里手动筛好城市/岗位后，把地址粘到这里。
BOSS_START_URL=

# 固定招呼语。review / auto 模式必须填写，请替换成你自己的内容。
BOSS_FIXED_GREETING=

# ─── 运行模式（三选一）──────────────────────────────────────────────────────

# 扫描模式：只抓取和记录，不发送。
BOSS_SCAN_ONLY=1

# 审核模式：命中后展示岗位详情和固定招呼语，确认后发送。
# BOSS_REVIEW_BEFORE_SEND=1

# 自动模式：命中规则后按随机等待节奏发送固定招呼语。
# BOSS_AUTO_SEND_FIXED_GREETING=1

# Dry-run：不真实点击发送，用于测试规则和流程。
DRY_RUN=1

# ─── 本地关键词规则 ─────────────────────────────────────────────────────────

# 自动发送标题必需关键词，可留空表示不限制。
BOSS_AUTO_TITLE_REQUIRED_TERMS=

# 自动发送标题方向关键词，命中任一即可。
BOSS_AUTO_TITLE_KEYWORDS=后端开发,ai

# 扫描模式必需关键词，可留空表示不限制。
BOSS_SCAN_REQUIRED_TERMS=

# 扫描模式方向关键词，命中任一即可。
BOSS_SCAN_KEYWORDS=后端开发,ai

# 扫描模式城市关键词，可留空表示不限制。
BOSS_SCAN_LOCATIONS=

# 审核模式必需关键词，可留空表示不限制。
BOSS_REVIEW_REQUIRED_TERMS=

# 审核模式城市关键词，可留空表示不限制。
BOSS_REVIEW_LOCATIONS=

# 扫描岗位上限。
BOSS_SCAN_MAX_JOBS=50

# ─── 发送节奏和风控兜底 ───────────────────────────────────────────────────

# 每次自动发送后的随机等待区间，单位秒。
BOSS_AUTO_SEND_DELAY_MIN=10
BOSS_AUTO_SEND_DELAY_MAX=60

# 单次运行发送上限。
BOSS_AUTO_SEND_MAX_SENT=50

# 每日发送上限，会读取 sent log 继续计数。
BOSS_AUTO_SEND_DAILY_LIMIT=80

# 检测到验证码或安全验证后停止。
BOSS_STOP_ON_CAPTCHA=1

# ─── 浏览器和日志 ───────────────────────────────────────────────────────────

# 独立 Chrome profile 目录。第一次扫码登录后 cookie 会保存在这里。
# BOSS_CHROME_PROFILE=./chrome_profile

# 扫描命中日志。
SCAN_MATCH_LOG_PATH=./logs/scan_matches.jsonl

# 运行状态日志。使用 profile 时通常由 profiles/*.yml 设置。
# BOSS_SEEN_JOBS_FILE=./logs/seen_jobs.jsonl
# BOSS_SENT_LOG_FILE=./logs/sent_jobs.jsonl
# BOSS_SKIPPED_LOG_FILE=./logs/skipped_jobs.jsonl

# 固定招呼语审计日志。
LETTER_LOG_PATH=./logs/letters.jsonl

# 日志级别。
LOGLEVEL=INFO
