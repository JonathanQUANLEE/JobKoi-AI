{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "JobKoi-AI · 全智能求职锦鲤助手",
  "version": "0.7.1",
  "identifier": "com.jonathanquanlee.jobkoi-ai",
  "build": {
    "beforeDevCommand": "pnpm --dir ../tauri-ui dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --dir ../tauri-ui build",
    "frontendDist": "../src/boss_zhipin/tauri/frontend",
    "features": ["pytauri/standalone"]
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "JobKoi-AI · 全智能求职锦鲤助手",
        "label": "main",
        "theme": "Dark",
        "decorations": false,
        "shadow": true,
        "width": 1240,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-",
      "entitlements": "./entitlements.plist"
    },
    "windows": {
      "wix": {
        "language": ["zh-CN"]
      },
      "nsis": {
        "languages": ["SimpChinese"],
        "installerIcon": "icons/icon.ico",
        "installerHooks": "./windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI2RDUwQzFBODA1NzM0ODYKUldTR05GZUFHZ3pWdGpRNVU4ZFMyenBWbmZQTUNvOWdoMjNhYVZRU3lqeWNTTG9jSWhiZ0pocFkK",
      "endpoints": [
        "https://github.com/JonathanQUANLEE/JobKoi-AI/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
